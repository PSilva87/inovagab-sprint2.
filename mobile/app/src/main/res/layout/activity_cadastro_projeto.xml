<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cadastrar Projeto"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/brand_navy"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/editNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nome do Projeto"
            android:inputType="textCapSentences"
            android:textLocale="pt-BR" />

        <EditText
            android:id="@+id/editDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descrição"
            android:inputType="textCapSentences|textMultiLine"
            android:textLocale="pt-BR"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estratégia vinculada"
            android:textColor="@color/brand_muted"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <Spinner
            android:id="@+id/spinnerEstrategia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/editInvestimento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Investimento"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/editPrazo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Toque para selecionar o prazo"
            android:focusable="false"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnSalvar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SALVAR PROJETO"
            android:textColor="@color/white"
            android:backgroundTint="@color/brand_blue"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
