<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="InovaGAB"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/brand_navy"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Área do Operador"
            android:textSize="18sp"
            android:textColor="@color/brand_muted"
            android:layout_marginBottom="32dp"/>

        <Button
            android:id="@+id/btnIdeias"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Cadastrar Ideia"
            android:textSize="18sp"
            android:backgroundTint="@color/brand_navy"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnListar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Minhas Ideias"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/brand_blue"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/btnEstrategias"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Estratégias da Empresa"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/brand_sky"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>
